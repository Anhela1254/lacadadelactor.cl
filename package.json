{
  "name": "la-casa-del-actor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"npm run dev:api\" \"npm run dev:web\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:api": "cross-env LCA_DEMO_ACCOUNTS=1 node server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "start": "cross-env NODE_ENV=production node server/index.js",
    "admin": "node server/admin.js",
    "test": "node --test",
    "demo:crear": "node server/seed-demo.js"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  }
}
